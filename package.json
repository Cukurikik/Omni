  "scripts": {
    "start": "node bin/omni.mjs",
    "dev": "nodemon --exec tsx bin/omni.mjs",
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --outfile=dist/omni.js",
    "build:gateway": "cd api && go build -o ../bin/omni-gateway.exe ./...",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:gateway": "cd api && go test ./... -v -count=1",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist build node_modules/.cache",
    "gateway": "cd api && go run main.go",
    "cloud:deploy": "gcloud run deploy omni-gateway --source api/ --region asia-southeast1",
    "cloud:logs": "gcloud logging read --project=omni-tool-9c48b --limit=50",
    "models:test": "cd .. && go test ./models/ -v -count=1",
    "docker:build": "docker build -t omni-framework .",
    "docker:run": "docker run -p 8080:8080 omni-framework"
  }
}