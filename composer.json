{
    "name": "omni/business-layer",
    "description": "OMNI Framework PHP Business Layer Orchestrator",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "ANTIGRAVITY MOTHER",
            "email": "mother@omniframework.dev"
        }
    ],
    "require": {
        "php": ">=8.4",
        "grpc/grpc": "^1.62",
        "google/protobuf": "^4.25",
        "symfony/console": "^7.0",
        "symfony/dotenv": "^7.0",
        "symfony/http-client": "^7.0",
        "monolog/monolog": "^3.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Omni\\Business\\": "src/business/",
            "Omni\\Security\\": "src/security/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
