# ===========================================================================
# OMNI FRAMEWORK — Environment Variables Template
# ===========================================================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the `.env` file to version control.
# ===========================================================================

# --- OMNI Core ---
OMNI_ENV=development
OMNI_LOG_LEVEL=INFO
OMNI_ENGINE_ROOT=./src/compute/python_core
OMNI_REGISTRY_AUTO_SCAN=true

# --- API Keys (Required for LLM/AI Engines) ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
HUGGINGFACE_TOKEN=your_hf_token_here

# --- Cloud Infrastructure (GCP) ---
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=asia-southeast2
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-service-account.json

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/omni
REDIS_URL=redis://localhost:6379/0

# --- MLOps ---
WANDB_API_KEY=your_wandb_api_key_here
MLFLOW_TRACKING_URI=http://localhost:5000
CLEARML_API_ACCESS_KEY=your_clearml_access_key
CLEARML_API_SECRET_KEY=your_clearml_secret_key

# --- Serving ---
OMNI_GATEWAY_HOST=0.0.0.0
OMNI_GATEWAY_PORT=8080
OMNI_GATEWAY_WORKERS=4

# --- Security ---
OMNI_SECRET_KEY=generate_a_strong_random_key_here
OMNI_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
OMNI_RATE_LIMIT_PER_MINUTE=100

# --- Feature Flags ---
OMNI_ENABLE_TELEMETRY=true
OMNI_ENABLE_AUTO_SCALING=false
OMNI_ENABLE_DEBUG_MODE=false
