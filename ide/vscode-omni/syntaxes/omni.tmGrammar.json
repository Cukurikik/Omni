{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OMNI",
  "scopeName": "source.omni",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#decorators" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#language-namespaces" },
    { "include": "#bridge-imports" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.omni",
          "match": "^\\s*///.*$"
        },
        {
          "name": "comment.line.double-slash.omni",
          "match": "//.*$"
        },
        {
          "name": "comment.block.omni",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.omni",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.omni",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.omni",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.omni",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.backtick.omni",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.omni",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.omni",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.omni",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.omni",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.tag.decorator.omni",
          "match": "@(schema|html_template|julia_simd|ebpf_kernel|cpp_template|omni_bridge|entry|test|bench|inline|deprecated|experimental)\\b"
        },
        {
          "name": "entity.name.tag.decorator.generic.omni",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.omni",
          "match": "\\b(if|else|match|for|while|loop|break|continue|return|yield|await|async)\\b"
        },
        {
          "name": "keyword.declaration.omni",
          "match": "\\b(fn|pub|mod|use|import|from|export|extern|type|struct|enum|trait|impl|interface|class)\\b"
        },
        {
          "name": "keyword.binding.omni",
          "match": "\\b(immutable|mutable|val|var|let|const|static)\\b"
        },
        {
          "name": "keyword.memory.omni",
          "match": "\\b(own|borrow|unsafe_zone|defer|drop|move|clone|copy)\\b"
        },
        {
          "name": "keyword.concurrency.omni",
          "match": "\\b(spawn|goroutine|channel|select|mutex|atomic|evloop)\\b"
        },
        {
          "name": "keyword.service.omni",
          "match": "\\b(service|component|route|handler|middleware|pipeline)\\b"
        },
        {
          "name": "keyword.other.omni",
          "match": "\\b(in|as|is|not|and|or|where|self|super|crate|package)\\b"
        },
        {
          "name": "constant.language.boolean.omni",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.omni",
          "match": "\\b(nil|null|None)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.result.omni",
          "match": "\\b(Result|Ok|Err|Option|Some|None)\\b"
        },
        {
          "name": "support.type.primitive.omni",
          "match": "\\b(i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|f32|f64|bool|char|str|String|Vec|Map|Set|Array|Tuple|UUID|Money)\\b"
        },
        {
          "name": "support.type.atomic.omni",
          "match": "\\b(AtomicU32|AtomicU64|AtomicI32|AtomicI64|AtomicBool|Mutex|RwLock|Arc|Rc)\\b"
        },
        {
          "name": "entity.name.type.omni",
          "match": "\\b[A-Z][a-zA-Z0-9]+\\b"
        }
      ]
    },
    "language-namespaces": {
      "patterns": [
        {
          "name": "support.class.namespace.omni",
          "match": "\\b(py|ts|cs|rb|r|c|rust|swift|php|go|julia|cpp)\\s*::"
        },
        {
          "name": "support.class.namespace.domain.omni",
          "match": "\\b(cs::domain|rb::route|r::stat|swift::UIKit|php::web|py::np|py::torch)\\b"
        },
        {
          "name": "keyword.other.extern.omni",
          "match": "extern\\s+\"omni-[a-z]+\"\\s+fn"
        }
      ]
    },
    "bridge-imports": {
      "patterns": [
        {
          "name": "support.module.bridge.omni",
          "match": "@omni-bridge/[a-z]+/[a-z_]+"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.omni",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.omni",
          "match": "->"
        },
        {
          "name": "keyword.operator.fat-arrow.omni",
          "match": "=>"
        },
        {
          "name": "keyword.operator.propagate.omni",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.assignment.omni",
          "match": "=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.omni",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.omni",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.logical.omni",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.scope.omni",
          "match": "::"
        }
      ]
    }
  }
}
