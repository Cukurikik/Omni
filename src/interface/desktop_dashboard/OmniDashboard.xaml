<!-- @omni-layer Interface | @omni-lang XAML (WPF/MAUI) | @omni-batch 17 -->
<!-- @omni-description Desktop AI dashboard: XAML layout for model inference -->
<!-- monitoring with Material Design cards, charts, and real-time metrics. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OMNI Inference Dashboard" Width="1200" Height="800"
        Background="#0A0E17" Foreground="#E2E8F0"
        FontFamily="Segoe UI, Inter">

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1F36"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
        </Style>
        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#60A5FA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#1A1F36" Padding="20,14" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock FontSize="18" FontWeight="Bold">
                    <Run Text="🧠 " /><Run Text="OMNI Inference Dashboard" Foreground="#60A5FA"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnPrimary}" Content="Refresh" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="Deploy" Background="#10B981"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats Row -->
        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="14,10">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding TotalInferences}"/>
                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="Total Inferences"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding AvgLatencyMs, StringFormat={}{0:F1}ms}" Foreground="#22D3EE"/>
                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="Avg Latency"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding ActiveModels}" Foreground="#A78BFA"/>
                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="Active Models"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding GpuUtilization, StringFormat={}{0:F0}%}" Foreground="#10B981"/>
                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="GPU Utilization"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main Content -->
        <Grid Margin="14,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Model List -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📊 Model Registry" FontSize="14" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,12"/>
                    <ListView ItemsSource="{Binding Models}" Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#E2E8F0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LatencyMs, StringFormat={}{0}ms}" Foreground="#22D3EE"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Accuracy, StringFormat={}{0:P0}}" Foreground="#10B981"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="#A78BFA"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- Sidebar -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🔧 Quick Inference" FontSize="13" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,8"/>
                        <TextBox Background="#0A0E17" Foreground="#E2E8F0" BorderBrush="#334155" Padding="8" MinHeight="60" AcceptsReturn="True" Text="{Binding InputText}"/>
                        <Button Style="{StaticResource BtnPrimary}" Content="Run Inference" Margin="0,8,0,0" Command="{Binding RunInferenceCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
