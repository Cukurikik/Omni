<!-- OMNI Interface — XAML Windows Desktop Layout -->
<Window x:Class="OmniDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OMNI Enterprise Command" Height="600" Width="800" Background="#1E1E1E">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="OMNI Cluster Status: ONLINE" Foreground="#00FF00" FontFamily="Consolas" FontSize="18" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" Background="#2D2D30">
            <TextBlock Name="ChatHistory" Foreground="White" FontFamily="Consolas" Padding="10" TextWrapping="Wrap"/>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="InputBox" Grid.Column="0" Background="#3E3E42" Foreground="White" FontFamily="Consolas" FontSize="16" Padding="5"/>
            <Button Name="SendButton" Grid.Column="1" Content="EXECUTE" Width="100" Margin="10,0,0,0" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
