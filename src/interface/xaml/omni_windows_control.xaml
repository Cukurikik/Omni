<Window x:Class="OmniFramework.ControlPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OMNI Control Panel" Height="300" Width="400" Background="#1E1E1E">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="OMNI Universal Bus" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <ProgressBar x:Name="CpuUsageBar" Value="45" Height="20" Foreground="#00FF88" Background="#333333" Margin="0,0,0,10"/>
            <TextBlock Text="Cluster Nodes: 1,024 Online" Foreground="#AAAAAA" FontSize="14" Margin="0,0,0,20"/>
            <Button Content="Synchronize" Background="#007ACC" Foreground="White" Height="35" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
