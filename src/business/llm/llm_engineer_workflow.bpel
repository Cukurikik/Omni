<?xml version="1.0" encoding="UTF-8"?>
<!-- 
OMNI Divine Memory Integration: Inspired by llm-engineer-toolkit
Business Layer - BPEL workflow for rigid sequential AI tool execution.
-->
<process name="LLMEngineerWorkflow" 
         targetNamespace="http://omni.nexus.dev/bpel/llm_engineer" 
         xmlns="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
         xmlns:tns="http://omni.nexus.dev/bpel/llm_engineer">

    <partnerLinks>
        <partnerLink name="client" partnerLinkType="tns:ClientInterface" myRole="provider"/>
        <partnerLink name="txtaiService" partnerLinkType="tns:TxtaiInterface" partnerRole="provider"/>
        <partnerLink name="powerinferService" partnerLinkType="tns:PowerinferInterface" partnerRole="provider"/>
    </partnerLinks>

    <variables>
        <variable name="inputQuery" messageType="tns:QueryMessage"/>
        <variable name="embeddedVector" messageType="tns:VectorMessage"/>
        <variable name="llmResponse" messageType="tns:ResponseMessage"/>
    </variables>

    <sequence>
        <!-- 1. Receive Request -->
        <receive partnerLink="client" portType="tns:ClientPort" operation="processQuery" variable="inputQuery" createInstance="yes"/>

        <!-- 2. Invoke txtai for Semantic Embeddings -->
        <invoke partnerLink="txtaiService" portType="tns:TxtaiPort" operation="getEmbedding" inputVariable="inputQuery" outputVariable="embeddedVector"/>

        <!-- 3. Invoke PowerInfer for Fast Local Generation -->
        <invoke partnerLink="powerinferService" portType="tns:PowerinferPort" operation="generateResponse" inputVariable="embeddedVector" outputVariable="llmResponse"/>

        <!-- 4. Reply to Client -->
        <reply partnerLink="client" portType="tns:ClientPort" operation="processQuery" variable="llmResponse"/>
    </sequence>
</process>
