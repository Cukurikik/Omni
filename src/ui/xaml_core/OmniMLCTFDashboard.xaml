<Window x:Class="Omni.UI.MLCTFDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Omni ML CTF Validator" Height="600" Width="800"
        Background="#0D1117">
    <Grid>
        <!-- Omni XAML Interface Layer -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Machine Learning CTF Validator" 
                   Foreground="#C9D1D9" FontSize="24" 
                   HorizontalAlignment="Center" Margin="10"/>
                   
        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="Adversarial Payload Hash:" Foreground="#8B949E" Margin="0,0,0,5"/>
            <TextBox x:Name="HashInput" Background="#161B22" Foreground="#C9D1D9" Height="30" Margin="0,0,0,20"/>
            
            <Button x:Name="ValidateBtn" Content="Validate Integrity" 
                    Background="#238636" Foreground="#FFFFFF" Height="40"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
