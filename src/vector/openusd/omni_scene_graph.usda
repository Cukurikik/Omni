#usda 1.0
(
    doc = """OMNI Vector — OpenUSD Scene Graph.
    Used for representing 3D spatial contexts that physical AI agents operate within."""
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "OmniSimulationEnvironment"
{
    def Xform "Agents"
    {
        def Capsule "OmniAgent_01"
        {
            double height = 1.8
            double radius = 0.4
            color3f[] primvars:displayColor = [(0.1, 0.8, 0.1)]
            double3 xformOp:translate = (0, 0.9, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "Environment"
    {
        def Cube "Floor"
        {
            double size = 20.0
            color3f[] primvars:displayColor = [(0.2, 0.2, 0.2)]
            double3 xformOp:scale = (1, 0.05, 1)
            double3 xformOp:translate = (0, -0.05, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        
        def Sphere "TargetObject"
        {
            double radius = 0.5
            color3f[] primvars:displayColor = [(0.9, 0.1, 0.1)]
            double3 xformOp:translate = (5, 0.5, -5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
