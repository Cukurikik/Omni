# OMNI Framework Snort IDS Rules for DDoS Mitigation
alert tcp any any -> $HOME_NET 443 (msg:"OMNI SYN Flood Detected"; flags:S; threshold:type both, track by_src, count 100, seconds 1; classtype:denial-of-service; sid:1000001; rev:1;)
alert udp any any -> $HOME_NET 53 (msg:"OMNI DNS Amplification Attack"; dsize:>1000; itype:8; threshold:type both, track by_src, count 50, seconds 1; classtype:attempted-dos; sid:1000002; rev:1;)
alert tcp any any -> $HOME_NET 8080 (msg:"OMNI Slowloris Attack Pattern"; flags:A; dsize:0; threshold:type both, track by_dst, count 500, seconds 10; classtype:attempted-dos; sid:1000003; rev:1;)
