@ffi("csharp", "domain/csharp_core/omni_csharp_cqrs_domain_engine.cs")
extern module CSharpCQRSEngine {
  class CQRSCommandHandler {
    fn HandleCreateOrder(customerId: String) -> DomainResult<Guid>
    fn HandleAddItem(orderId: Guid, productId: String, name: String, price: Decimal, qty: Int) -> DomainResult<Bool>
    fn HandleSubmitOrder(orderId: Guid) -> DomainResult<Bool>
  }

  class CQRSQueryHandler {
    fn GetOrder(orderId: Guid) -> DomainResult<OrderAggregate>
    fn GetOrdersByCustomer(customerId: String) -> DomainResult<List<OrderAggregate>>
    fn Diagnostics() -> Dict<String, Object>
  }
}

