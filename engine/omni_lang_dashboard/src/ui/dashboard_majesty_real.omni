// Pilar Web Environment - React Server Components (RSC) tanpa manipulasi DOM tiruan.

import { createRoot } from "omni/ui/react";
import { Suspense } from "omni/ui/react";
import { AgentBrainContext } from "@omni-bridge/singularity/context";

// Dikonversi langsung ke Vite/Next.js lewat kompilasi OMNI.
@html_template("Singularity Dashboard")
export function RootDashboard() {
    return (
        <div className="bg-void min-h-screen grid items-center justify-center p-8 text-cyan-400 font-mono">
            <header className="absolute top-0 w-full p-4 border-b border-cyan-800/30 flex justify-between">
                <span>⚡ OMNI ENTERPRISE INTERFACE</span>
                <span className="animate-pulse">CONNECTED</span>
            </header>
            
            <main className="max-w-4xl w-full border border-cyan-500/20 rounded-xl p-8 backdrop-blur-md bg-cyan-900/10 shadow-[0_0_50px_rgba(6,182,212,0.1)]">
                <h1 className="text-4xl tracking-widest font-bold mb-4 drop-shadow-[0_0_10px_rgba(6,182,212,0.8)]">
                    OMNI NEURAL CLOUD
                </h1>
                
                <Suspense fallback={<div className="animate-pulse">Menghubungkan HFT Bridge...</div>}>
                    <RealTimeMetrics />
                </Suspense>
            </main>
        </div>
    );
}

// Data Component tersambung via UAST ke Go CGO memory
async function RealTimeMetrics() {
    const memoryStats = await AgentBrainContext.GetHFTTraffic();
    
    return (
        <div className="grid grid-cols-2 gap-4 mt-8">
            <div className="p-4 border border-cyan-800/50 rounded-lg">
                <h3 className="text-cyan-600 mb-2">HFT OMNI-BRIDGE</h3>
                <p className="text-2xl">{memoryStats.throughput} TPS</p>
            </div>
            <div className="p-4 border border-cyan-800/50 rounded-lg">
                <h3 className="text-cyan-600 mb-2">MEMORY ALLOCATION</h3>
                <p className="text-2xl">{memoryStats.zero_copy_ram} MB</p>
            </div>
        </div>
    );
}
