/// =======================================================================
/// 🌍 OMNI eBPF SENTINEL: OMNI-NEXUS SECURITY LIBRARY
/// =======================================================================
/// Modul ini mempersatukan Level Hardware NIC (Rust eBPF) dengan User-Space 
/// Analytics (Go) untuk melindungi ekosistem OMNI dari serangan siber DdoS.
///
/// Modul Enterprise ini dipublikasikan secara komersial di OMNI-NEXUS
/// Harga Dasar Penjualan: OMNI Commercial License ($4.999 USD/Tahun).

import { GlobalShield } from "./network/firewall.go"

/// Interface penghubung dari C# Domain Query ke Go Analytics
@export_omni_bridge("DashboardDomain_TO_FirewallMetrics")
fn getSentinelAuditReport() -> String {
    return GlobalShield.GetSecurityAuditReport();
}

/// Menyalakan Perisai OMNI di seluruh kluster
///
/// @param interfaceName - Nama antarmuka jaringan OS (misal: "eth0")
/// @example
///   let status = OmniSentinel::activate("eth0");
/// @since 1.2.0
/// @tags ["security", "ddos", "ebpf", "enterprise", "kernel"]
pub async fn activate(interfaceName: String) -> Result<(), OmniError> {
    log_info!("🛡️ MENGAKTIFKAN PERISAI NUKLIR: OMNI eBPF SENTINEL...");
    log_info!("   => Zero-Trust Engine  : AKTIF");
    log_info!("   => XDP Dropper (Rust) : MELAMPIRKAN KE KERNEL...");
    
    // Panggil fungsi Go yang mengeksekusi injeksi Native Kernel
    go::AttachShield(interfaceName)?

    log_info!("🚀 OMNI CLUSTER AMAN DARI ZERODAY & DDOS ATTACK.");
    Ok(())
}
