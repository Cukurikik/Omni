// 1. Deklarasi Import Tiga Engine Ekstrim!
import { WebsocketHandler, SocketHub } from "./network/socket_engine.go"
import { compress_payload_ring0 } from "./system/compressor.rs"
import { RuntimeBillingGuard } from "./domain/billing_guard.ts"

// 2. Registrasi Interoperabilitas Bahasa Tanpa-Salinan (Zero-Copy Bridge)
@export_omni_bridge("BillingDomain_TO_SocketGateway")
fn checkBillingQuotaViaTSBridge(apiKey: String) -> Boolean {
   let guard = RuntimeBillingGuard::new();
   return await guard.interceptConnection(apiKey)
}

/// Menjalankan Server Utama
///
/// @param port - Port gateway masuk
/// @example
///   let hub = OmniTelemetryHub::boot(8080);
/// @since 1.0.0
/// @tags ["saas", "realtime", "websocket", "enterprise"]
pub async fn boot(port: Int) -> Result<(), OmniError> {
    log_info!("🚀 Memulai Mesin Mesin Uang: OMNI REALTIME TELEMETRY HUB...");
    log_info!("   => C-ABI Compressor : AKTIF");
    log_info!("   => Async Core Go    : AKTIF");
    log_info!("   => TS Stripe Guard  : AKTIF");
    
    // Konfigurasi HTTP Server di Lapisan Go
    go::http::HandleFunc("/sync", WebsocketHandler)
    
    let target = format!("0.0.0.0:{}", port);
    log_info!("⚡ Mendengarkan koneksi websocket pada {}", target);
    
    // Block thread (Listen and Serve)
    go::http::ListenAndServe(target, nil)?

    Ok(())
}
